<form class="webm-settings-form" autocomplete="off">
  <header class="form-header" style="display:flex;align-items:center;justify-content:space-between;gap:8px;">
    <div>
      {{localize 'origin-vault.ui.categorySettings' max=max}}
      <span class="count-badge" style="margin-left:8px;opacity:.8;">{{count}}/{{max}}</span>
    </div>
    <div class="cat-actions">
      <button type="button" data-action="add-cat" {{#if hasReachedMax}}disabled{{/if}}>
        <i class="fas fa-plus"></i> {{localize 'origin-vault.ui.addCategory'}}
      </button>
    </div>
  </header>

  <section class="form-body">
    {{#each categories as |cat|}}
    <div class="cat-row" data-key="{{cat.key}}">
      <div class="row-title">{{localize 'origin-vault.ui.category'}} {{cat.index}}</div>
      <div class="row-fields">
        <label>{{localize 'origin-vault.ui.name'}}</label>
        <input type="text" name="{{cat.key}}-name" value="{{cat.name}}"
          placeholder="{{localize 'origin-vault.ui.categoryName'}}">

        <label>{{localize 'origin-vault.ui.source'}}</label>
        <select name="{{cat.key}}-source">
          <option value="data" {{#if (eq cat.source "data" )}}selected{{/if}}>data</option>
          <option value="s3" {{#if (eq cat.source "s3" )}}selected{{/if}}>s3</option>
        </select>

        <label>{{localize 'origin-vault.ui.folder'}}</label>
        <input type="text" name="{{cat.key}}-folder" value="{{cat.folder}}"
          placeholder="{{localize 'origin-vault.ui.folderPlaceholder'}}">
        <button type="button" class="browse" data-key="{{cat.key}}" title="{{localize 'origin-vault.ui.browse'}}"><i
            class="fas fa-folder-open"></i></button>
        <button type="button" class="upload" data-key="{{cat.key}}" title="{{localize 'origin-vault.ui.uploadWebm'}}"><i
            class="fas fa-upload"></i> {{localize 'origin-vault.ui.uploadWebm'}}</button>

        <button type="button" class="remove-cat" data-key="{{cat.key}}"
          title="{{localize 'origin-vault.ui.deleteCategory'}}" style="margin-left:6px;">
          <i class="fas fa-trash"></i>
        </button>
      </div>
    </div>
    {{/each}}
  </section>

  <footer class="form-footer">
    <button type="submit" class="save"><i class="fas fa-save"></i> {{localize 'origin-vault.settings.save'}}</button>
  </footer>
</form>
